rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function conversationMember(conversationId) {
      return signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /listings/{listingId} {
      allow read: if signedIn() && (resource.data.status == "Active" || resource.data.sellerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.status in ["Active", "Draft", "Sold"];
      allow update: if signedIn() && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.sellerId == request.auth.uid;
    }

    match /favourites/{favouriteId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if conversationMember(resource.data.conversationId);
      allow create: if conversationMember(request.resource.data.conversationId)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }
  }
}
