<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/campus_background"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivConversationAvatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="Conversation profile image"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_campus_market_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvConversationName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/campus_text_black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/ivConversationAvatar"
            app:layout_constraintStart_toEndOf="@id/ivConversationAvatar"
            app:layout_constraintEnd_toStartOf="@id/tvConversationTime" />

        <TextView
            android:id="@+id/tvConversationPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/campus_text_grey"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvConversationName"
            app:layout_constraintStart_toEndOf="@id/ivConversationAvatar"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvConversationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/campus_text_grey"
            android:textSize="12sp"
            app:layout_constraintTop_toTopOf="@id/tvConversationName"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/viewUnread"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/bg_unread_dot"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/ivConversationAvatar"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>