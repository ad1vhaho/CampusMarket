<?xml version="1.0" encoding="utf-8"?>
<resources>


        <!--
            CampusMarket primary green button.
            Used for actions such as Login, Register,
            Publish Listing and Message Seller.
        -->
        <style name="CampusGreenButton" parent="Widget.Material3.Button">

            <item name="backgroundTint">@color/campus_green_dark</item>
            <item name="android:textColor">@color/white</item>

            <item name="cornerRadius">12dp</item>

            <item name="android:minHeight">56dp</item>
            <item name="android:layout_height">56dp</item>

            <item name="textAllCaps">false</item>
            <item name="android:fontFamily">sans-serif-medium</item>

        </style>

        <!--
            CampusMarket white outlined button.
            Used for secondary actions such as
            Continue with Google, Save Draft and
            Add to Favourites.
        -->
        <style name="CampusWhiteButton" parent="Widget.Material3.Button.OutlinedButton">

            <item name="backgroundTint">@color/white</item>
            <item name="android:textColor">@color/campus_text_black</item>

            <item name="strokeColor">@color/campus_border_grey</item>

            <item name="cornerRadius">12dp</item>

            <item name="android:minHeight">56dp</item>
            <item name="android:layout_height">56dp</item>

            <item name="textAllCaps">false</item>
            <item name="android:fontFamily">sans-serif-medium</item>

        </style>
</resources>
